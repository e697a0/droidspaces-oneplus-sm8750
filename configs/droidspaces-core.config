# SPDX-License-Identifier: GPL-2.0
#
# Droidspaces — CORE configuration (mandatory)
# =====================================================================
# Kernel: LineageOS android_kernel_oneplus_sm8750 (SM8750 / "sun", 6.6.x, GKI)
# Source: ravindu644/Droidspaces-OSS  Documentation/Kernel-Configuration.md
#         (GKI section, kernel < 6.12)
#
# !! IMPORTANT !!
# Every option below is only kABI-safe because
#   patches/001.droidspaces-sysvipc-kabi.patch
# is applied first. That patch moves `struct sysv_sem` / `struct sysv_shm`
# out of their natural place in `struct task_struct` and into unused
# ANDROID_KABI_RESERVE() padding slots, so enabling CONFIG_SYSVIPC does not
# shift any struct offset. Without it the device bootloops.
#
# Do NOT paste this file at the end of gki_defconfig. It is merged with
# scripts/kconfig/merge_config.sh, then materialised with `make olddefconfig`.
# =====================================================================

# --- IPC mechanisms (kABI-critical) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Namespaces (kABI-neutral: nsproxy is always present) ---
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# --- Device filesystem ---
CONFIG_DEVTMPFS=y

# --- Networking: enhanced NAT support ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Below: optional but recommended by upstream ---

# Fixes "unsafe procfs" inside Docker / Podman / LXC
CONFIG_USER_NS=y

# UFW
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# xattr / POSIX ACL on tmpfs (needed by NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
