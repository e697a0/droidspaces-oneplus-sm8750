# SPDX-License-Identifier: GPL-2.0
#
# Droidspaces — OPTIONAL: NTSYNC (NT synchronization primitives)
# =====================================================================
# This is NOT part of the official Droidspaces requirement list.  It is only
# needed when you want to run Windows software (Wine / Proton / Steam) inside
# a Droidspaces container.
#
# Requires patches/optional/ntsync/ (the driver is a brand-new file, so it
# cannot be expressed as a pure config fragment).  Enable it with the
# "ntsync" workflow input, which runs scripts/enable-ntsync.sh first.
#
# Built into the kernel image (=y) rather than as a module: this project only
# flashes the kernel Image and deliberately leaves vendor_dlkm untouched.
# =====================================================================

CONFIG_NTSYNC=y
