# SPDX-License-Identifier: GPL-2.0
#
# Droidspaces — CONTAINER / NAMESPACE / CGROUP extras
# =====================================================================
# These are NOT in the upstream "GKI" list but are ABI-neutral (none of them
# changes the layout of any structure that an exported symbol depends on) and
# they are required or strongly recommended for full container functionality
# (cgroup limits, overlayfs volatile mode, firmware loading, tmpfs ACL/xattr).
#
# If your device fails to boot, run the build with profile=core first to
# bisect.  See docs/FLASHING.md.
# =====================================================================

# --- Namespaces ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y

# --- Seccomp (Droidspaces "seccomp shield") ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Control groups ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# --- devtmpfs ---
# CONFIG_DEVTMPFS=y lives in droidspaces-core.config.
#
# CONFIG_DEVTMPFS_MOUNT is deliberately NOT set: it makes the kernel auto-mount
# devtmpfs at /dev during early init, which is a change to the boot path that
# neither the stock LineageOS sm8750 kernel nor the verified-working reference
# project for this platform makes.  The upstream Droidspaces requirements only
# ask for CONFIG_DEVTMPFS=y, so the mount is unnecessary.
# CONFIG_DEVTMPFS_MOUNT is not set

# --- OverlayFS (Droidspaces volatile mode) ---
CONFIG_OVERLAY_FS=y

# --- Firmware loading inside containers ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
# CONFIG_FW_LOADER_COMPRESS is deliberately NOT set.
# It is the one item of this profile that sits on the early driver-probe path:
# it teaches the kernel to decompress firmware.  This device needs none of that
# (/vendor/firmware holds 87 files and every one is uncompressed), the stock
# kernel does not enable it, and the verified-working sm8750 reference project
# does not either.  core boots with it off; full reboot-looped with it on, so
# drop it before bisecting anything else.
# CONFIG_FW_LOADER_COMPRESS is not set
